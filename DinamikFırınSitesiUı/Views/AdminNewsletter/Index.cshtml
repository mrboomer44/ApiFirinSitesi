@model IEnumerable<DinamikFırınSitesiUı.Dtos.NewsletterEmail.ResultNewsletterEmailDto>

@{
    ViewData["Title"] = "Bülten Aboneleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold text-dark mb-0">Bülten Aboneleri</h5>
        <small class="text-muted">Fırınınızdan haber ve kampanya mailleri almak isteyen kullanıcıların listesi.</small>
    </div>
    <!-- Ekleme butonu yok, çünkü veriler dışarıdan (müşterilerden) geliyor -->
    <div class="bg-warning bg-opacity-10 text-dark px-4 py-2 rounded-pill fw-medium border border-warning">
        <i class="fa-solid fa-users me-2 text-warning"></i> Toplam Abone: @(Model?.Count() ?? 0)
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 px-4 py-3" style="width: 80px;">#</th>
                        <th class="border-0 py-3">Kayıtlı E-Posta Adresi (Emails)</th>
                        <th class="border-0 text-end px-4 py-3" style="width: 150px;">İşlem</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-envelope-open fs-1 mb-3" style="color: #dee2e6;"></i><br />
                                Henüz bülteninize abone olan kimse bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int count = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 fw-bold text-muted">@count</td>
                                <td class="py-3 fw-medium text-dark">
                                    <i class="fa-regular fa-envelope text-secondary opacity-50 me-2"></i> @item.Emails
                                </td>
                                <td class="text-end px-4 py-3">
                                    <!-- Sadece SİLME butonu var -->
                                    <a href="/AdminNewsletter/DeleteNewsletter/@item.NewsletterEmailId" class="btn btn-sm btn-light border text-danger" onclick="return confirm('Bu e-posta adresini aboneler listesinden çıkarmak (silmek) istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash me-1"></i> Sil
                                    </a>
                                </td>
                            </tr>
                            count++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>