@model DinamikFırınSitesiUı.Dtos.SocialMedias.UpdateSocialMediaDto

@{
    ViewData["Title"] = "Sosyal Medya Güncelle"; Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">Sosyal Medya Hesapları Güncelle</h5>
    <a href="/AdminContactSettings/Index" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium">
        <i class="fa-solid fa-arrow-left me-2"></i> Listeye Dön
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 col-lg-8">
    <div class="card-body p-4 p-md-5">
        <form action="/AdminContactSettings/UpdateSocialMedia" method="post">
            <input type="hidden" name="SocialMediaId" value="@Model.SocialMediaId" />
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Facebook</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-brands fa-facebook text-primary"></i></span>
                        <input type="text" class="form-control bg-light border-0 shadow-none" name="Facebook" value="@Model.Facebook" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">X (Twitter)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-brands fa-x-twitter text-dark"></i></span>
                        <input type="text" class="form-control bg-light border-0 shadow-none" name="X" value="@Model.X" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Instagram</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-brands fa-instagram text-danger"></i></span>
                        <input type="text" class="form-control bg-light border-0 shadow-none" name="Instagram" value="@Model.Instagram" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">LinkedIn (Linkedn)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-brands fa-linkedin text-info"></i></span>
                        <input type="text" class="form-control bg-light border-0 shadow-none" name="Linkedn" value="@Model.Linkedn" />
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end border-top pt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" style="background-color: #d97706; border: none;">
                    <i class="fa-solid fa-arrows-rotate me-2"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>