@model DinamikFırınSitesiUı.Dtos.Communications.UpdateCommunicationDto

@{
    ViewData["Title"] = "İletişim Bilgisi Güncelle"; Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">İletişim Bilgisi Güncelle</h5>
    <a href="/AdminContactSettings/Index" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium">
        <i class="fa-solid fa-arrow-left me-2"></i> Listeye Dön
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 col-lg-8">
    <div class="card-body p-4 p-md-5">
        <form action="/AdminContactSettings/UpdateCommunication" method="post">
            <input type="hidden" name="CommunicationId" value="@Model.CommunicationId" />
            <div class="mb-4">
                <label class="form-label fw-bold text-dark mb-2">Adres (Adress)</label>
                <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="Adress" value="@Model.Adress" required />
            </div>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Telefon (Phone)</label>
                    <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="Phone" value="@Model.Phone" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">E-Posta (Mail)</label>
                    <input type="email" class="form-control form-control-lg bg-light border-0 shadow-none" name="Mail" value="@Model.Mail" required />
                </div>
            </div>
            <div class="d-flex justify-content-end border-top pt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" style="background-color: #d97706; border: none;">
                    <i class="fa-solid fa-arrows-rotate me-2"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>