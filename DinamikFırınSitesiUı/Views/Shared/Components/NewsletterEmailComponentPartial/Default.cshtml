<div class="bg-primary text-light rounded-top p-5 my-6 mb-0 wow fadeInUp" data-wow-delay="0.1s">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="display-4 text-light mb-0">Subscribe Our Newsletter</h1>
        </div>
        <div class="col-md-6 text-md-end">
            <form asp-controller="Default" asp-action="NewsletterSubscribe" method="post">
                <div class="position-relative">
                    <input name="Emails" class="form-control bg-transparent border-light w-100 py-3 ps-4 pe-5" type="email" placeholder="Your email" required>
                    <button type="submit" class="btn btn-dark py-2 px-3 position-absolute top-0 end-0 mt-2 me-2">SignUp</button>
                </div>
            </form>
            @if (TempData["NewsletterMessage"] != null)
            {
                <small class="d-block mt-2 text-light">@TempData["NewsletterMessage"]</small>
            }
        </div>
    </div>
</div>