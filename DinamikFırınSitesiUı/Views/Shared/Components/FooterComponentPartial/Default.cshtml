@model DinamikFırınSitesiUı.Models.FooterViewModel

<div class="container-fluid bg-dark text-light footer my-6 mb-0 py-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-3 col-md-6">
                <h4 class="text-light mb-4">Office Address</h4>
                <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i>@Model?.Communication?.Adress</p>
                <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>@Model?.Communication?.Phone</p>
                <p class="mb-2"><i class="fa fa-envelope me-3"></i>@Model?.Communication?.Mail</p>
                <div class="d-flex pt-2">
                    <a class="btn btn-square btn-outline-light rounded-circle me-1" href="@Model?.SocialMedia?.X"><i class="fab fa-twitter"></i></a>
                    <a class="btn btn-square btn-outline-light rounded-circle me-1" href="@Model?.SocialMedia?.Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a class="btn btn-square btn-outline-light rounded-circle me-1" href="@Model?.SocialMedia?.Instagram"><i class="fab fa-instagram"></i></a>
                    <a class="btn btn-square btn-outline-light rounded-circle me-0" href="@Model?.SocialMedia?.Linkedn"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <h4 class="text-light mb-4">Quick Links</h4>
                <a class="btn btn-link" href="@Url.Action("Index", "About")">About</a>
                <a class="btn btn-link" href="@Url.Action("Index", "Contact")">Contact</a>
                <a class="btn btn-link" href="@Url.Action("Index", "Services")">Services</a>
                <a class="btn btn-link" href="@Url.Action("Index", "Product")">Product</a>
            </div>
            <div class="col-lg-3 col-md-6">
                <h4 class="text-light mb-4">Photo Gallery</h4>
                <div class="row g-2">
                    @foreach (var item in Model?.Galeries?.Take(12) ?? Enumerable.Empty<DinamikFırınSitesiUı.Dtos.Galerys.ResultGaleryDto>())
                    {
                        <div class="col-4">
                            <img class="img-fluid bg-light rounded p-1" src="@item.ImageUrl" alt="Image">
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>