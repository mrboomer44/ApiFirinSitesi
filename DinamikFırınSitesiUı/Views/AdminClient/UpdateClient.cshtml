@model DinamikFırınSitesiUı.Dtos.Clients.UpdateClientDto

@{
    ViewData["Title"] = "Yorum Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">Müşteri Yorumunu Güncelle</h5>
    <a href="/AdminClient/Index" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium">
        <i class="fa-solid fa-arrow-left me-2"></i> Listeye Dön
    </a>
</div>

<div class="row">
    <!-- Form Alanı -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 p-md-5">
                <form action="/AdminClient/UpdateClient" method="post">
                    
                    <input type="hidden" name="ClientId" value="@Model.ClientId" />

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-2">Adı (Name)</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="Name" value="@Model.Name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-2">Soyadı (SurName)</label>
                            <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="SurName" value="@Model.SurName" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Müşteri Yorumu (Description)</label>
                        <textarea class="form-control bg-light border-0 shadow-none" name="Description" rows="5" required>@Model.Description</textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Fotoğraf URL (ImageUrl)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fa-solid fa-image text-primary"></i></span>
                            <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="ImageUrl" value="@Model.ImageUrl" required />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4 mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" style="background-color: #d97706; border: none;">
                            <i class="fa-solid fa-arrows-rotate me-2"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Önizleme Alanı -->
    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <h6 class="fw-bold text-dark mb-4">Müşteri Önizlemesi</h6>
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="rounded-circle shadow-sm mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="@Model.Name" />
                }
                else
                {
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mb-3 mx-auto" style="width: 150px; height: 150px;">
                        <span class="text-muted"><i class="fa-solid fa-user fs-1"></i></span>
                    </div>
                }
                <h5 class="fw-bold text-dark mb-1">@Model.Name @Model.SurName</h5>
                <div class="text-warning mb-2">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                </div>
                <p class="text-muted small fst-italic">"@Model.Description"</p>
            </div>
        </div>
    </div>
</div>