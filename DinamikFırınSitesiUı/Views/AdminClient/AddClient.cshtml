@model DinamikFırınSitesiUı.Dtos.Clients.CreateClientDto

@{
    ViewData["Title"] = "Yeni Yorum Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">Yeni Müşteri Yorumu Ekle</h5>
    <a href="/AdminClient/Index" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium">
        <i class="fa-solid fa-arrow-left me-2"></i> Listeye Dön
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 col-lg-8">
    <div class="card-body p-4 p-md-5">
        
        <form action="/AdminClient/AddClient" method="post">
            
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Adı (Name)</label>
                    <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="Name" placeholder="Örn: Ayşe" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Soyadı (SurName)</label>
                    <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="SurName" placeholder="Örn: Demir" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-dark mb-2">Müşteri Yorumu (Description)</label>
                <textarea class="form-control bg-light border-0 shadow-none" name="Description" rows="5" placeholder="Müşterinin fırınınız ve ürünleriniz hakkındaki güzel sözleri..." required></textarea>
            </div>

            <div class="mb-5">
                <label class="form-label fw-bold text-dark mb-2">Fotoğraf URL (ImageUrl)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="fa-solid fa-image text-primary"></i></span>
                    <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="ImageUrl" placeholder="Müşterinin görsel linkini girin..." required />
                </div>
            </div>

            <div class="d-flex justify-content-end border-top pt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" style="background-color: #d97706; border: none;">
                    <i class="fa-solid fa-plus me-2"></i> Yorumu Kaydet
                </button>
            </div>
            
        </form>

    </div>
</div>