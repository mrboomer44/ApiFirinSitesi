@model List<DinamikFırınSitesiUı.Dtos.Counters.ResultCounterDto>

@{
    ViewData["Title"] = "İstatistik Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    // Veri olup olmadığını listeden kontrol ediyoruz
    bool hasData = Model != null && Model.Any();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">İstatistik (Sayaç) Yönetimi</h5>
    
    <!-- EĞER VERİ YOKSA EKLE BUTONU ÇIKAR -->
    @if (!hasData)
    {
        <a href="/AdminCounter/AddCounter" class="btn btn-primary rounded-pill px-4 fw-medium" style="background-color: #d97706; border: none;">
            <i class="fa-solid fa-plus me-2"></i> İlk İstatistik Verisini Ekle
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 px-4 py-3">Yıllık Deneyim<br><small class="text-muted fw-normal">(Counter 1)</small></th>
                        <th class="border-0 py-3">Uzman Personel<br><small class="text-muted fw-normal">(Counter 2)</small></th>
                        <th class="border-0 py-3">Toplam Ürün<br><small class="text-muted fw-normal">(Counter 3)</small></th>
                        <th class="border-0 py-3">Günlük Sipariş<br><small class="text-muted fw-normal">(Counter 4)</small></th>
                        <th class="border-0 text-end px-4 py-3">İşlem</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    
                    <!-- EĞER VERİ YOKSA BOŞ UYARISI VERİR -->
                    @if (!hasData)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-chart-bar fs-1 mb-3" style="color: #dee2e6;"></i><br />
                                Sitenizde gösterilecek istatistik verisi bulunmuyor.<br />Yukarıdaki butonu kullanarak ilk veriyi ekleyin.
                            </td>
                        </tr>
                    }
                    else
                    {
                        <!-- EĞER VERİ VARSA SADECE O VERİYİ LİSTELER -->
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 fw-bold text-dark fs-5">@item.Counter1</td>
                                <td class="py-3 fw-bold text-dark fs-5">@item.Counter2</td>
                                <td class="py-3 fw-bold text-dark fs-5">@item.Counter3</td>
                                <td class="py-3 fw-bold text-dark fs-5">@item.Counter4</td>
                                <td class="text-end px-4 py-3">
                                    <a href="/AdminCounter/UpdateCounter/@item.CounterId" class="btn btn-sm btn-primary px-3 py-2 rounded-3 border-0" style="background-color: #d97706;" title="Verileri Güncelle">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>