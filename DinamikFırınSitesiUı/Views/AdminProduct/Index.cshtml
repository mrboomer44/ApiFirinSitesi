@model List<DinamikFırınSitesiUı.Dtos.Products.ResultProductDto>

@{
    ViewData["Title"] = "Ürün Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold text-dark mb-0">Ürün Yönetimi</h5>
        <small class="text-muted">Fırınınızda sattığınız tüm ürünleri buradan yönetebilirsiniz.</small>
    </div>
    <a href="/AdminProduct/AddProduct" class="btn btn-primary rounded-pill px-4 fw-medium" style="background-color: #d97706; border: none;">
        <i class="fa-solid fa-plus me-2"></i> Yeni Ürün Ekle
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 px-4 py-3" style="width: 100px;">Görsel</th>
                        <th class="border-0 py-3">Ürün Adı (Title)</th>
                        <th class="border-0 py-3">Açıklama (Description)</th>
                        <th class="border-0 py-3">Fiyat Aralığı</th>
                        <th class="border-0 text-end px-4 py-3" style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-basket-shopping fs-1 mb-3" style="color: #dee2e6;"></i><br />
                                Menünüzde henüz bir ürün bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <img src="@item.ImageUrl" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" alt="@item.Title">
                                </td>
                                <td class="py-3 fw-bold text-dark">@item.Title</td>
                                <td class="py-3 text-secondary text-truncate" style="max-width: 250px;">@item.Description</td>
                                <td class="py-3 fw-medium text-success">
                                    ₺@item.StrartPrice - ₺@item.EndPrice
                                </td>
                                <td class="text-end px-4 py-3">
                                    <a href="/AdminProduct/UpdateProduct/@item.ProductId" class="btn btn-sm btn-light border text-primary me-2">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a href="/AdminProduct/DeleteProduct/@item.ProductId" class="btn btn-sm btn-light border text-danger" onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>