@model DinamikFırınSitesiUı.Dtos.Products.UpdateProductDto

@{
    ViewData["Title"] = "Ürün Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">Ürün Güncelle</h5>
    <a href="/AdminProduct/Index" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium">
        <i class="fa-solid fa-arrow-left me-2"></i> Listeye Dön
    </a>
</div>

<div class="row">
    <!-- Form Alanı -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 p-md-5">
                <form action="/AdminProduct/UpdateProduct" method="post">
                    
                    <input type="hidden" name="ProductId" value="@Model.ProductId" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Ürün Adı (Title)</label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="Title" value="@Model.Title" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Açıklama (Description)</label>
                        <textarea class="form-control bg-light border-0 shadow-none" name="Description" rows="4" required>@Model.Description</textarea>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-2">Başlangıç Fiyatı (StrartPrice)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-turkish-lira-sign text-primary"></i></span>
                                <input type="text" class="form-control bg-light border-0 shadow-none" name="StrartPrice" value="@Model.StrartPrice" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-2">Bitiş/Maks Fiyat (EndPrice)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fa-solid fa-turkish-lira-sign text-primary"></i></span>
                                <input type="text" class="form-control bg-light border-0 shadow-none" name="EndPrice" value="@Model.EndPrice" required />
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <label class="form-label fw-bold text-dark mb-2">Ürün Görseli URL (ImageUrl)</label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="ImageUrl" value="@Model.ImageUrl" required />
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" style="background-color: #d97706; border: none;">
                            <i class="fa-solid fa-arrows-rotate me-2"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Önizleme Alanı -->
    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <h6 class="fw-bold text-dark mb-4">Mevcut Ürün Görseli</h6>
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm mb-3" style="width: 100%; object-fit: cover; aspect-ratio: 1/1;" alt="@Model.Title" />
                }
                else
                {
                    <div class="bg-light rounded-4 d-flex align-items-center justify-content-center mb-3" style="height: 200px;">
                        <span class="text-muted"><i class="fa-solid fa-image-slash me-2"></i> Görsel Yok</span>
                    </div>
                }
                <p class="text-secondary small mb-0">Ürünün menüde ve anasayfada görünen fotoğrafı.</p>
            </div>
        </div>
    </div>
</div>