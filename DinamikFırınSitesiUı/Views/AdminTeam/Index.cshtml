@model IEnumerable<DinamikFırınSitesiUı.Dtos.Teams.ResultTeamDto>

@{
    ViewData["Title"] = "Ekip Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold text-dark mb-0">Ekip Yönetimi</h5>
        <small class="text-muted">Fırınınızda çalışan ustaları ve personelleri buradan yönetebilirsiniz.</small>
    </div>
    <a href="/AdminTeam/AddTeam" class="btn btn-primary rounded-pill px-4 fw-medium" style="background-color: #d97706; border: none;">
        <i class="fa-solid fa-plus me-2"></i> Yeni Personel Ekle
    </a>
</div>
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 px-4 py-3" style="width: 90px;">Fotoğraf</th>
                        <th class="border-0 py-3">Ad Soyad</th>
                        <th class="border-0 py-3">Pozisyon (Unvan)</th>
                        <th class="border-0 py-3 text-center">Sosyal Medya</th>
                        <th class="border-0 text-end px-4 py-3" style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users fs-1 mb-3" style="color: #dee2e6;"></i><br />
                                Henüz ekibe kayıtlı personel bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <img src="@item.ImageUrl" class="rounded-circle shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" alt="@item.Name">
                                </td>
                                <td class="py-3 fw-bold text-dark">@item.Name @item.Surname</td>
                                <td class="py-3 text-secondary">@item.Position</td>
                                <td class="py-3 text-center fs-5">
                                    <!-- Facebook -->
                                    <i class="fa-brands fa-facebook @(string.IsNullOrEmpty(item.Facebook) ? "text-secondary opacity-25" : "text-primary") me-1"></i>
    
                                    <!-- X -->
                                    <span class="@(string.IsNullOrEmpty(item.X) ? "text-secondary opacity-25" : "text-dark") me-1 d-inline-flex align-items-center">
                                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                            <path fill="currentColor" d="M18.244 2H21.5l-7.116 8.131L22 22h-5.964l-4.67-6.104L5.997 22H2.739l7.611-8.701L2 2h6.115l4.221 5.557L18.244 2zm-1.047 18h1.804L7.136 3.895H5.2L17.197 20z" />
                                        </svg>
                                    </span>
    
                                    <!-- Instagram -->
                                    <i class="fa-brands fa-instagram @(string.IsNullOrEmpty(item.Instagram) ? "text-secondary opacity-25" : "text-danger")"></i>
                                </td>
                                <td class="text-end px-4 py-3">
                                    <a href="/AdminTeam/UpdateTeam/@item.TeamId" class="btn btn-sm btn-light border text-primary me-2">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a href="/AdminTeam/DeleteTeam/@item.TeamId" class="btn btn-sm btn-light border text-danger" onclick="return confirm('Bu personeli silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>