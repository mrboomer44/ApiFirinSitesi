@model DinamikFırınSitesiUı.Dtos.Teams.CreateTeamDto

@{
    ViewData["Title"] = "Yeni Personel Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">Yeni Personel Ekle</h5>
    <a href="/AdminTeam/Index" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium">
        <i class="fa-solid fa-arrow-left me-2"></i> Listeye Dön
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 col-lg-9">
    <div class="card-body p-4 p-md-5">
        
        <form action="/AdminTeam/AddTeam" method="post">
            
            <h6 class="text-uppercase text-muted fw-bold mb-3"><i class="fa-solid fa-user me-2"></i>Kişisel Bilgiler</h6>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Adı (Name)</label>
                    <input type="text" class="form-control bg-light border-0 shadow-none" name="Name" placeholder="Örn: Ahmet" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Soyadı (Surname)</label>
                    <input type="text" class="form-control bg-light border-0 shadow-none" name="Surname" placeholder="Örn: Yılmaz" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Pozisyon (Position)</label>
                    <input type="text" class="form-control bg-light border-0 shadow-none" name="Position" placeholder="Örn: Baş Pastacı" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-2">Fotoğraf URL (ImageUrl)</label>
                    <input type="text" class="form-control bg-light border-0 shadow-none" name="ImageUrl" placeholder="Görsel linkini girin..." required />
                </div>
            </div>

            <h6 class="text-uppercase text-muted fw-bold mb-3 mt-5"><i class="fa-solid fa-hashtag me-2"></i>Sosyal Medya Bağlantıları <small class="text-lowercase fw-normal">(Opsiyonel)</small></h6>
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <label class="form-label text-dark mb-2">Facebook</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-brands fa-facebook text-primary"></i></span>
                        <input type="text" class="form-control bg-light border-0 shadow-none" name="Facebook" placeholder="Link..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-dark mb-2">X (Twitter)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-brands fa-x-twitter text-dark"></i></span>
                        <input type="text" class="form-control bg-light border-0 shadow-none" name="X" placeholder="Link..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-dark mb-2">Instagram</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0"><i class="fa-brands fa-instagram text-danger"></i></span>
                        <input type="text" class="form-control bg-light border-0 shadow-none" name="Instagram" placeholder="Link..." />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end border-top pt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" style="background-color: #d97706; border: none;">
                    <i class="fa-solid fa-plus me-2"></i> Personeli Kaydet
                </button>
            </div>
            
        </form>

    </div>
</div>