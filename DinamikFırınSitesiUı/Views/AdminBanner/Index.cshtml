@model List<DinamikFırınSitesiUı.Dtos.Banners.ResultBannerDto>

@{
    ViewData["Title"] = "Banner (Afiş) Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">Ana Sayfa Afişleri</h5>
    <!-- Yeni Veri Ekleme Butonu (Sayfaya Linklenir) -->
    <a href="/AdminBanner/AddBanner" class="btn btn-primary rounded-pill px-4 fw-medium" style="background-color: #d97706; border: none;">
        <i class="fa-solid fa-plus me-2"></i> Yeni Banner Ekle
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 px-4 py-3" style="width: 120px;">Görsel</th>
                        <th class="border-0 py-3">Etiket (Ticket)</th>
                        <th class="border-0 py-3">Başlık (Title)</th>
                        <th class="border-0 py-3">Açıklama</th>
                        <th class="border-0 text-end px-4 py-3" style="width: 200px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Henüz hiç banner eklenmemiş. Hemen bir tane oluşturun!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- Küçük Görsel Alanı -->
                                <td class="px-4 py-3">
                                    <img src="@item.ImageUrl" alt="@item.Title" class="shadow-sm" style="width: 90px; height: 60px; object-fit: cover; border-radius: 8px;" />
                                </td>
                                
                                <!-- Ticket (Örn: Taze Çıktı!) -->
                                <td class="py-3">
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-2">@item.Ticket</span>
                                </td>
                                
                                <!-- Başlık -->
                                <td class="py-3 fw-bold text-dark">
                                    @item.Title
                                </td>
                                
                                <!-- Açıklama (Uzunsa kesilir) -->
                                <td class="py-3 text-secondary text-truncate" style="max-width: 250px;">
                                    @item.Description
                                </td>
                                
                                <!-- Aksiyon Butonları -->
                                <td class="text-end px-4 py-3">
                                    <a href="/AdminBanner/UpdateBanner/@item.BannerId" class="btn btn-sm btn-light border text-primary me-2" title="Güncelle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a href="/AdminBanner/DeleteBanner/@item.BannerId" class="btn btn-sm btn-light border text-danger" title="Sil" onclick="return confirm('Bu bannerı silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>