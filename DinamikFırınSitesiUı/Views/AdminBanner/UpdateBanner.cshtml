@model DinamikFırınSitesiUı.Dtos.Banners.UpdateBannerDto

@{
    ViewData["Title"] = "Afiş Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Üst Başlık ve Geri Dön Butonu -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold text-dark mb-0">Banner (Afiş) Güncelle</h5>
    <a href="/AdminBanner/Index" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium">
        <i class="fa-solid fa-arrow-left me-2"></i> Listeye Dön
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                
                <!-- Form Başlangıcı -->
                <form action="/AdminBanner/UpdateBanner" method="post">
                    
                    <!-- GÜNCELLEME İÇİN KRİTİK: ID'yi Gizli Olarak Tutuyoruz -->
                    <input type="hidden" name="BannerId" value="@Model.BannerId" />
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Etiket (Ticket)</label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="Ticket" value="@Model.Ticket" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Başlık (Title)</label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="Title" value="@Model.Title" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark mb-2">Açıklama (Description)</label>
                        <!-- Textarea'da value kullanılmaz, etiketler arasına yazılır -->
                        <textarea class="form-control bg-light border-0 shadow-none" name="Description" rows="4" required>@Model.Description</textarea>
                    </div>

                    <div class="mb-5">
                        <label class="form-label fw-bold text-dark mb-2">Görsel URL (ImageUrl)</label>
                        <input type="text" class="form-control form-control-lg bg-light border-0 shadow-none" name="ImageUrl" value="@Model.ImageUrl" required />
                    </div>

                    <div class="d-flex justify-content-end border-top pt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold" style="background-color: #d97706; border: none;">
                            <i class="fa-solid fa-arrows-rotate me-2"></i> Değişiklikleri Kaydet
                        </button>
                    </div>

                </form>
                <!-- Form Bitişi -->

            </div>
        </div>
    </div>

    <!-- Sağ Tarafa Mevcut Görsel Önizlemesi -->
    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 text-center">
                <h6 class="fw-bold text-dark mb-3">Mevcut Görsel Önizlemesi</h6>
                
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded-4 shadow-sm mb-3" style="max-height: 200px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light rounded-4 d-flex align-items-center justify-content-center mb-3" style="height: 150px;">
                        <span class="text-muted"><i class="fa-solid fa-image-slash me-2"></i> Görsel Yok</span>
                    </div>
                }
                
                <p class="text-secondary small mb-0">
                    Yeni bir URL girdiğinizde görsel kaydedildikten sonra güncellenecektir.
                </p>
            </div>
        </div>
    </div>
</div>