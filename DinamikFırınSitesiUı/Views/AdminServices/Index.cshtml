@model DinamikFırınSitesiUı.Models.ServicesViewModel

@{
    ViewData["Title"] = "Hizmetler Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    bool hasMainServiceData = Model.Services != null && Model.Services.Any();
}

<!-- ========================================== -->
<!-- BÖLÜM 1: ANA HİZMET İÇERİĞİ YÖNETİMİ -->
<!-- ========================================== -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold text-dark mb-0">Hizmetler (Ana İçerik)</h5>
        <small class="text-muted">Hizmetler sayfasının ana başlığı, genel açıklaması ve görselleri.</small>
    </div>
    @if (!hasMainServiceData)
    {
        <a href="/AdminServices/AddServices" class="btn btn-primary rounded-pill px-4 fw-medium" style="background-color: #d97706; border: none;">
            <i class="fa-solid fa-plus me-2"></i> Ana İçeriği Oluştur
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4 mb-5">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 px-4 py-3" style="width: 130px;">Görseller</th>
                        <th class="border-0 py-3">Başlık (Title)</th>
                        <th class="border-0 py-3">Açıklama (Description)</th>
                        <th class="border-0 text-end px-4 py-3" style="width: 150px;">İşlem</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (!hasMainServiceData)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Ana hizmet içeriği bulunamadı. Lütfen ekleyin.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Services)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="d-flex gap-2">
                                        <img src="@item.ImageUrl1" class="rounded shadow-sm" style="width: 45px; height: 45px; object-fit: cover;">
                                        <img src="@item.ImageUrl2" class="rounded shadow-sm" style="width: 45px; height: 45px; object-fit: cover;">
                                    </div>
                                </td>
                                <td class="py-3 fw-bold text-dark">@item.Title</td>
                                <td class="py-3 text-secondary text-truncate" style="max-width: 300px;">@item.Description</td>
                                <td class="text-end px-4 py-3">
                                    <a href="/AdminServices/UpdateServices/@item.ServicesId" class="btn btn-sm btn-primary px-3 py-2 rounded-3 border-0" style="background-color: #d97706;">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- BÖLÜM 2: HİZMET MADDELERİ (SERVICES LIST) -->
<!-- ========================================== -->
<div class="d-flex justify-content-between align-items-center mb-4 border-top pt-4">
    <div>
        <h5 class="fw-bold text-dark mb-0">Hizmet Detayları (Alt Liste)</h5>
        <small class="text-muted">Müşterilerinize sunduğunuz spesifik hizmetlerin başlıkları ve açıklamaları.</small>
    </div>
    <a href="/AdminServices/AddServicesList" class="btn btn-primary rounded-pill px-4 fw-medium" style="background-color: #d97706; border: none;">
        <i class="fa-solid fa-plus me-2"></i> Yeni Hizmet Ekle
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 px-4 py-3">Hizmet Başlığı (Title)</th>
                        <th class="border-0 py-3">Hizmet Açıklaması (Description)</th>
                        <th class="border-0 text-end px-4 py-3" style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.ServicesLists == null || !Model.ServicesLists.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">Henüz listeye hizmet maddesi eklenmemiş.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.ServicesLists)
                        {
                            <tr>
                                <td class="px-4 py-3 fw-bold text-dark">@item.Title</td>
                                <td class="py-3 text-secondary text-truncate" style="max-width: 400px;">@item.Description</td>
                                <td class="text-end px-4 py-3">
                                    <a href="/AdminServices/UpdateServicesList/@item.ServicesListId" class="btn btn-sm btn-light border text-primary me-2">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <a href="/AdminServices/DeleteServicesList/@item.ServicesListId" class="btn btn-sm btn-light border text-danger" onclick="return confirm('Bu hizmeti silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>